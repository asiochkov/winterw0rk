# Copy to .env and fill in. Never commit the real .env.

# REQUIRED IN PRODUCTION — the server refuses to start without it.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Optional. Defaults to 8787.
PORT=8787

# Set to "production" to enable secure cookies, HSTS and strict config checks.
NODE_ENV=development

# Optional. Defaults to ./winterwork.db next to the server package.
# DB_PATH=/var/lib/winterwork/winterwork.db

# Payment provider. Leave blank until a provider is set up: with no key the app
# reports subscriptions as unavailable instead of faking a purchase.
BILLING_PROVIDER_SECRET_KEY=
BILLING_PROVIDER_WEBHOOK_SECRET=
