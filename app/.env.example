# Copy to .env and fill in. Production refuses to start without the required ones.

# REQUIRED — signs session cookies. Generate with: openssl rand -hex 32
SESSION_SECRET=

# REQUIRED — absolute public URL, used to build links inside emails.
APP_URL=https://winterwork.example.com

# OPTIONAL. Leave SMTP_HOST empty to launch without email: sign-up and sign-in
# work as usual, self-service password reset is closed, and reminder emails are
# off. See "Running without email" in DEPLOY.md.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Winterwork <no-reply@winterwork.example.com>

# REQUIRED — named in the Privacy Policy and Terms as the operator of the
# service. Baked into the client bundle at build time, so these are public.
VITE_LEGAL_OPERATOR_NAME=
VITE_LEGAL_OPERATOR_LOCATION=
VITE_LEGAL_CONTACT_EMAIL=

# Optional
PORT=8787
REMINDERS_ENABLED=true
# DB_PATH and CLIENT_DIR are set by the Docker image; override only outside Docker.
