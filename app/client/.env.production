# Operator details the Privacy Policy and Terms are required to name. Vite
# loads this automatically for `vite build`, so every build — Docker, Render,
# local — gets them without build arguments, which not every host can pass.
#
# These are baked into the client bundle and shown on /privacy and /terms, so
# they are public by design. Nothing secret belongs in this file.
VITE_LEGAL_OPERATOR_NAME=Арсений Иочков
VITE_LEGAL_OPERATOR_LOCATION=Россия
VITE_LEGAL_CONTACT_EMAIL=iochkovas@gmail.com
